# Collected on the host for every debug bundle (see tests/collect.sh for the format).
# One collector per line: <output file> | <command>. Run from the repository root.
git-sha.txt | git rev-parse HEAD
git-dirty.txt | git status --porcelain
git-describe.txt | git describe --tags --always --dirty
timestamps.txt | echo "started:  ${TEST_STARTED:-unknown}"; echo "finished: ${TEST_FINISHED:-unknown}"
host-uname.txt | uname -srvm
make-vars.txt | for v in ${MAKE_VARS:-}; do echo "$v"; done
test-target.txt | echo "${TEST_TARGET_INFO:-host run (no device)}"
env-overrides.txt | for v in PAK_MISMATCH SET_HOTKEYS SAVE_KEYS NEXT_SLOT_KEYS SRC_PAK RELEASE_ZIP JPG2BMP PLATFORM OUT_DIR KEEP LAUNCH_SHELL TMP_ROOT PSP_KEYS EXIT_KEYS BOOT_WAIT UI_WAIT BOOT_SETTLE UI_SETTLE NOGAME_WAIT NOGAME_SETTLE REBOOT_DOWN_TIMEOUT REBOOT_UP_TIMEOUT RESUME_TIMEOUT KEY_GAP SDCARD_PATH ROM_DIR ROM; do eval "if [ -n \"\${$v+x}\" ]; then echo \"$v=\${$v}\"; fi"; done
tool-versions.txt | bash --version | head -n 1; make --version | head -n 1; jq --version; git --version; file --version | head -n 1; shellcheck --version | sed -n 2p; unzip -v | head -n 1; gcc --version | head -n 1; tests/lib/bats-core/bin/bats --version
