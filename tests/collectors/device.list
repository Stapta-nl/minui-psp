# Collected on the device after every on-device run (see tests/collect.sh for the format).
# One collector per line: <output file> | <command>. Runs in the unpacked test bundle with
# PLATFORM, PAK_NAME and SDCARD_PATH set; $SD is the SD card. Plain POSIX sh: it must work on BusyBox.
uname.txt | uname -a
os-release.txt | cat /etc/os-release 2>/dev/null || cat /etc/openwrt_release
busybox-version.txt | ls -l /bin/sh; strings /bin/busybox 2>/dev/null | grep -m 1 '^BusyBox v' || echo 'BusyBox version not found'
bash-version.txt | bash --version | head -n 1
nextui-version.txt | cat "$SD/.system/version.txt"
required-tools.txt | for t in bash tar gzip mktemp awk sort uniq cut nl pgrep killall; do printf '%s: ' "$t"; command -v "$t" || echo MISSING; done
df.txt | df -h
pak.json | cat "$SD/Emus/$PLATFORM/${PAK_NAME:-PSP}.pak/pak.json"
ppsspp.ini | sed -E 's/^([^=]*([Tt][Oo][Kk][Ee][Nn]|[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Uu][Ss][Ee][Rr][Nn][Aa][Mm][Ee])[^=]*=).*/\1<hidden>/' "$SD/Emus/$PLATFORM/${PAK_NAME:-PSP}.pak/PPSSPP/.config/ppsspp/PSP/SYSTEM/ppsspp.ini"
PSP.txt | cat "$SD/.userdata/$PLATFORM/logs/PSP.txt"
controls.ini | cat "$SD/Emus/$PLATFORM/${PAK_NAME:-PSP}.pak/PPSSPP/.config/ppsspp/PSP/SYSTEM/controls.ini"
minuisettings.txt | sed -E 's/^([^=]*([Tt][Oo][Kk][Ee][Nn]|[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Uu][Ss][Ee][Rr]|[Aa][Uu][Tt][Hh])[^=]*=).*/\1<hidden>/' "$SD/.userdata/shared/minuisettings.txt"
minui-state.txt | ls -l "$SD/.userdata/shared/.minui"; echo; cat "$SD/.userdata/shared/.minui/game_switcher.txt" 2>&1
